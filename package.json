{
  "name": "mlaz-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "npm --prefix server run build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:server": "npm --prefix server test",
    "test:security": "node --test test/csp.test.mjs && npm --prefix server run test:security",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "node scripts/check-format.mjs --fix",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "npm --prefix server run typecheck",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:whitespace": "git diff --check && git diff --cached --check",
    "security:deps": "node scripts/audit.mjs",
    "security:secrets": "node scripts/gitleaks.mjs",
    "check": "node scripts/check.mjs fast",
    "check:full": "node scripts/check.mjs full",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "sass": "^1.83.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "qrcode": "^1.5.4"
  }
}
