// MLAZ membership platform data model.
// Human-facing references (MLA-0421, APP-2042, PAY-7781, EXP-0001) are separate from the internal UUID keys
// and are allocated from the Counter table so they stay sequential.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/* ================= ACCOUNTS ================= */

enum Role {
  ADMIN // Secretariat Admin: full access, the checker in maker-checker
  MEMBERSHIP_OFFICER // applications, members, certificates; the maker
  FINANCE_OFFICER // payments, dues, reconciliation, expenses
  COMMS_OFFICER // announcements, broadcasts, events
  MEMBER // a member business's portal user
}

enum TokenPurpose {
  INVITE
  PASSWORD_RESET
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique // stored lower-case
  name         String
  title        String? // staff job title shown in the console, e.g. "Membership Officer"
  role         Role
  passwordHash String? // null until an invite is accepted
  active       Boolean   @default(true)
  memberId     String?
  member       Member?   @relation(fields: [memberId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  tokens          UserToken[]
  recommendations Application[]  @relation("Recommender")
  approvals       Application[]  @relation("Approver")

  @@index([memberId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use tokens for account invites and password resets. Only the SHA-256 hash is stored.
model UserToken {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
}

/* ================= CONFIGURATION ================= */

model Tier {
  name        String   @id // Gold, Silver, Bronze
  annualDues  Decimal  @db.Decimal(12, 2)
  description String   @default("")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  members      Member[]
  applications Application[]
}

// Key/value settings: joiningFee, renewalWindowDays, bankAccount, and job bookkeeping.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Counter {
  key   String @id
  value Int
}

/* ================= MEMBERSHIP ================= */

enum MemberStatus {
  ACTIVE
  LAPSED // membership period ended without dues being paid
  SUSPENDED // MoF authorization expired, or suspended by the Secretariat
}

enum AccreditationStatus {
  ISSUED
  EXPIRED
  REVOKED
}

enum MofStatus {
  VALID
  EXPIRED
}

enum SuspensionKind {
  MOF_EXPIRED // lifted automatically when a renewal is verified
  STAFF // imposed by the Secretariat; only staff can reinstate
}

model Member {
  id               String              @id @default(uuid())
  number           String              @unique // MLA-0421
  name             String
  town             String
  province         String
  address          String              @default("")
  tpin             String
  pacra            String              @default("")
  tierName         String
  tier             Tier                @relation(fields: [tierName], references: [name])
  status           MemberStatus        @default(ACTIVE)
  accreditation    AccreditationStatus @default(ISSUED)
  suspension       SuspensionKind?
  suspensionReason String?
  mofStatus        MofStatus           @default(VALID)
  mofRef           String
  mofExpiry        DateTime?           @db.Date
  validUntil       DateTime            @db.Date // end of the paid membership period
  contactName      String
  contactPhone     String
  contactEmail     String
  joinedAt         DateTime            @db.Date
  applicationId    String?             @unique
  application      Application?        @relation(fields: [applicationId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  users         User[]
  certificates  Certificate[]
  renewals      MofRenewal[]
  duesPayments  DuesPayment[]
  payments      Payment[]
  registrations Registration[]
  activity      MemberActivity[]
  documents     Document[]
  loans         Loan[]
  creditChecks  CreditCheck[]
  reminders     ReminderLog[]

  @@index([status])
  @@index([tierName])
  @@index([province])
}

// The member's timeline shown in the console and portal.
model MemberActivity {
  id       String   @id @default(uuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind     String // dues_paid, accreditation_issued, suspended, reinstated, reminder_sent, mof_renewal, profile_updated, event_registered
  title    String
  detail   String   @default("")
  at       DateTime @default(now())

  @@index([memberId, at])
}

enum CertificateStatus {
  VALID
  SUPERSEDED // a newer certificate was issued (e.g. after paying next year's dues)
  REVOKED
}

model Certificate {
  id         String            @id @default(uuid())
  serial     String            @unique // MLAZ/ACC/0421/26
  memberId   String
  member     Member            @relation(fields: [memberId], references: [id])
  issuedAt   DateTime          @default(now())
  validUntil DateTime          @db.Date
  status     CertificateStatus @default(VALID)

  @@index([memberId])
}

enum RenewalStatus {
  PENDING
  VERIFIED
  REJECTED
}

model MofRenewal {
  id           String        @id @default(uuid())
  memberId     String
  member       Member        @relation(fields: [memberId], references: [id])
  mofRef       String
  documentId   String?       @unique
  document     Document?     @relation(fields: [documentId], references: [id])
  status       RenewalStatus @default(PENDING)
  submittedAt  DateTime      @default(now())
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([status])
}

// One row per paid membership period.
model DuesPayment {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([memberId])
}

// Prevents a reminder (e.g. "accreditation expires in 30 days") being sent twice for the same period.
model ReminderLog {
  id       String   @id @default(uuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  key      String // e.g. expiry:30:2027-03-31
  sentAt   DateTime @default(now())

  @@unique([memberId, key])
}

/* ================= APPLICATIONS ================= */

enum ApplicationStage {
  DETAILS // submitted without (or returned for) a MoF authorization
  MOF_REVIEW // MoF authorization being verified; may carry a recommendation awaiting a checker
  PAYMENT_PENDING // approved; waiting for joining fee + first year's dues
  ACCREDITED
  REJECTED
}

// The applicant's tracking link carries a token derived from the ref with an HMAC (see lib/tokens.ts), so no token is stored.
model Application {
  id                String           @id @default(uuid())
  ref               String           @unique // APP-2042
  businessName      String
  town              String
  province          String
  address           String           @default("")
  pacra             String
  tpin              String
  tierName          String
  tier              Tier             @relation(fields: [tierName], references: [name])
  contactName       String
  position          String
  phone             String
  email             String
  directorName      String
  directorNrc       String
  mofRef            String?
  mofExpiry         DateTime?        @db.Date // read off the authorization by the recommending officer
  stage             ApplicationStage
  returnNote        String? // why the Secretariat sent it back to the applicant
  rejectionReason   String?

  recommendedById    String?
  recommendedBy      User?     @relation("Recommender", fields: [recommendedById], references: [id])
  recommendedAt      DateTime?
  recommendationNote String?
  approvedById       String?
  approvedBy         User?     @relation("Approver", fields: [approvedById], references: [id])
  approvedAt         DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member    Member?
  documents Document[]
  payments  Payment[]

  @@index([stage])
  @@index([tpin])
  @@index([pacra])
}

/* ================= DOCUMENTS ================= */

enum DocumentKind {
  MOF_AUTHORIZATION
  PACRA_CERTIFICATE
  DIRECTOR_NRC
  PROOF_OF_PAYMENT
  RESOURCE
}

model Document {
  id            String       @id @default(uuid())
  kind          DocumentKind
  storageKey    String       @unique
  filename      String
  mimeType      String
  size          Int
  sha256        String
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  memberId      String?
  member        Member?      @relation(fields: [memberId], references: [id])
  paymentId     String?
  payment       Payment?     @relation(fields: [paymentId], references: [id])
  uploadedBy    String // display label of the uploader
  superseded    Boolean      @default(false) // e.g. a MoF authorization replaced after the application was returned
  createdAt     DateTime     @default(now())

  renewal  MofRenewal?
  resource Resource?

  @@index([applicationId])
  @@index([memberId])
  @@index([paymentId])
}

/* ================= PAYMENTS ================= */

enum PaymentPurpose {
  APPLICATION // joining fee + first year's dues
  DUES
  EVENT
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  ZAMTEL_KWACHA
  IZYANE_QR
  CARD
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Payment {
  id             String         @id @default(uuid())
  ref            String         @unique // PAY-7781; also the receipt number
  purpose        PaymentPurpose
  applicationId  String?
  application    Application?   @relation(fields: [applicationId], references: [id])
  memberId       String?
  member         Member?        @relation(fields: [memberId], references: [id])
  registrationId String?        @unique
  registration   Registration?  @relation(fields: [registrationId], references: [id])
  payerName      String
  amount         Decimal        @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus  @default(PENDING)
  provider       String // sandbox, manual, ...
  providerRef    String?        @unique
  msisdn         String? // mobile money number
  checkoutUrl    String? // hosted card checkout
  qrPayload      String?
  bankRef        String? // payer's bank transaction reference
  failureReason  String?
  recordedBy     String? // staff who recorded an offline payment
  reviewedBy     String? // staff who confirmed or rejected a bank transfer
  reviewedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines     PaymentLine[]
  documents Document[]
  dues      DuesPayment?

  @@index([status])
  @@index([memberId])
  @@index([applicationId])
  @@index([createdAt])
}

enum LineType {
  JOINING_FEE
  DUES
  EVENT_TICKET
}

model PaymentLine {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type        LineType
  description String
  quantity    Int      @default(1)
  unitAmount  Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
}

/* ================= EVENTS ================= */

enum EventType {
  TRAINING
  WEBINAR
  AGM
  NETWORKING
}

enum EventStatus {
  PUBLISHED
  CANCELLED
}

model Event {
  id           String      @id @default(uuid())
  name         String      @unique
  type         EventType
  date         DateTime    @db.Date
  venue        String
  description  String      @default("")
  capacity     Int
  price        Decimal     @db.Decimal(12, 2) // per ticket; 0 = free
  status       EventStatus @default(PUBLISHED)
  cancelReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  registrations Registration[]
  expenses      Expense[]

  @@index([date])
}

enum RegistrationStatus {
  PENDING // places held while payment is in progress
  CONFIRMED
  CANCELLED
}

model Registration {
  id          String             @id @default(uuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id])
  memberId    String
  member      Member             @relation(fields: [memberId], references: [id])
  tickets     Int
  amount      Decimal            @db.Decimal(12, 2)
  status      RegistrationStatus
  refundDue   Boolean            @default(false) // paid registration on an event that was cancelled
  createdAt   DateTime           @default(now())
  cancelledAt DateTime?

  payment Payment?

  @@index([eventId, status])
  @@index([memberId])
}

/* ================= COMMUNICATIONS ================= */

model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  tag         String
  publishedAt DateTime @default(now())
  createdBy   String
}

model Broadcast {
  id             String   @id @default(uuid())
  subject        String
  body           String
  audience       String // ALL, DUES_OUTSTANDING, LAPSED, TIER:Gold, PROVINCE:Lusaka
  channels       String[] // EMAIL, SMS, PORTAL
  recipientCount Int
  createdBy      String
  createdAt      DateTime @default(now())

  notifications Notification[]
}

model Resource {
  id         String   @id @default(uuid())
  title      String
  category   String // BoZ & MoF circulars, Templates & forms, ...
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id])
  createdAt  DateTime @default(now())
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Outbox: rows are written in the same transaction as the change that triggers them, then delivered by the job runner.
model Notification {
  id          String              @id @default(uuid())
  channel     NotificationChannel
  to          String
  subject     String              @default("")
  body        String
  status      NotificationStatus  @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  sendAfter   DateTime            @default(now())
  sentAt      DateTime?
  broadcastId String?
  broadcast   Broadcast?          @relation(fields: [broadcastId], references: [id])
  createdAt   DateTime            @default(now())

  @@index([status, sendAfter])
}

/* ================= FINANCE ================= */

model Expense {
  id          String    @id @default(uuid())
  ref         String    @unique // EXP-0007
  date        DateTime  @db.Date
  category    String
  description String
  payee       String
  amount      Decimal   @db.Decimal(12, 2)
  method      String
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id])
  recordedBy  String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedBy   String?

  @@index([date])
}

/* ================= LENDING ================= */

enum LoanStatus {
  CURRENT
  ARREARS
  CLOSED
}

// A member's loan book. The latest bureau score is cached here so the customer list loads without bureau calls.
model Loan {
  id            String     @id @default(uuid())
  memberId      String
  member        Member     @relation(fields: [memberId], references: [id])
  borrowerNrc   String
  borrowerName  String
  borrowerPhone String     @default("")
  amount        Decimal    @db.Decimal(12, 2)
  balance       Decimal    @db.Decimal(12, 2)
  status        LoanStatus @default(CURRENT)
  issuedAt      DateTime   @db.Date
  lastScore     Int?
  lastCheckedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([memberId])
  @@index([borrowerNrc])
}

// Every bureau lookup, with who asked, why, and that the borrower consented.
model CreditCheck {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  userId    String
  nrc       String
  purpose   String
  consent   Boolean
  found     Boolean
  score     Int?
  report    Json?
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([nrc])
}

/* ================= AUDIT ================= */

enum ActorType {
  STAFF
  MEMBER
  APPLICANT
  SYSTEM
}

// Append-only record of every decision and change.
model AuditLog {
  id         String    @id @default(uuid())
  at         DateTime  @default(now())
  actorType  ActorType
  actorId    String?
  actorLabel String // "Grace Mwansa (Secretariat Admin)"
  target     String // APP-2042, MLA-0421, PAY-7781, Events, Settings...
  action     String
  note       String    @default("")
  ip         String?

  @@index([target])
  @@index([at])
}
