# Copy to .env and adjust. Every variable is validated at startup (src/config.ts).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://mlaz:mlaz@localhost:5435/mlaz
TEST_DATABASE_URL=postgresql://mlaz:mlaz@localhost:5435/mlaz_test
# Connection pool per instance, how long a request waits for a connection, and an optional per-statement cap
# in seconds (0 = none; reports and CSV exports can be slow).
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_SECONDS=0

# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
ACCESS_TOKEN_TTL_MINUTES=15
# A session ends after this many hours without use (idle), and in any case this many hours after sign-in (absolute).
# Refreshing never extends the absolute deadline. The absolute lifetime must be at least the idle timeout.
# (Replaces REFRESH_TOKEN_TTL_DAYS, which is no longer read.)
SESSION_IDLE_TIMEOUT_HOURS=24
SESSION_ABSOLUTE_LIFETIME_HOURS=168
# Encrypts two-factor secrets at rest. Generate like JWT_SECRET; keep it different from the other secrets.
DATA_ENCRYPTION_KEY=change-me-another-long-random-string-48-chars
# Require staff to use two-factor sign-in. Production refuses to start unless this is true.
REQUIRE_STAFF_2FA=false
# Only allow staff accounts on this email domain (empty = any).
STAFF_EMAIL_DOMAIN=mlaz.org.zm
# Refresh-token cookie is HTTPS-only by default in production; set false only for local HTTP testing.
# COOKIE_SECURE=
# Number of reverse-proxy hops to trust for client IPs (X-Forwarded-For). 0 = none. Set to 1 behind one load balancer.
# Production requires this to be set explicitly.
TRUST_PROXY_HOPS=0
# Requests per minute per IP across the API (sensitive endpoints have tighter limits of their own).
RATE_LIMIT_PER_MINUTE=300

# Comma-separated origins allowed to call the API (the Vite dev server and the deployed UI).
CORS_ORIGINS=http://localhost:5173
# Where the UI lives; used in emailed links and certificate QR codes.
PUBLIC_APP_URL=http://localhost:5173

# File storage: "local" writes to STORAGE_DIR; "s3" uses any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Uploads stream to private temporary files here (owner-only), never into memory. Must not be inside STORAGE_DIR.
# Default: <system temp>/mlaz-uploads
# UPLOAD_TMP_DIR=
# Per-file limit (MB, max 50), uploads in progress per instance, seconds to receive a whole upload,
# temporary space per instance (MB) and total space for all stored documents (MB).
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_CONCURRENT=8
UPLOAD_TIMEOUT_SECONDS=120
UPLOAD_TEMP_QUOTA_MB=400
STORAGE_QUOTA_MB=20480
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email: leave SMTP_URL empty to log emails to the console instead of sending them (one-time links are redacted).
# Production refuses to start without it.
SMTP_URL=
EMAIL_FROM="MLAZ Secretariat <no-reply@mlaz.org.zm>"
# SMS: "log" prints messages; plug a real gateway into src/providers/messaging.ts.
SMS_DRIVER=log
SMS_SENDER_ID=MLAZ

# Payments: "sandbox" simulates mobile money, QR and card. Settles SANDBOX_SETTLE_SECONDS after initiation.
# A mobile money number ending in 0000 simulates a declined payment.
PAYMENT_PROVIDER=sandbox
SANDBOX_SETTLE_SECONDS=5
# Seconds the payer waits for the gateway to accept a request. A late answer is still recorded and honoured.
PAYMENT_INITIATE_TIMEOUT_SECONDS=30
WEBHOOK_SECRET=change-me-webhook-secret

# Credit bureau: "simulated" returns deterministic made-up records per NRC.
BUREAU_DRIVER=simulated
CREDIT_CHECKS_PER_DAY=50

# Background jobs (notification outbox, payment settlement, nightly lapse/expiry). Safe to run on several instances at once.
JOBS_ENABLED=true
# Production refuses to start with PAYMENT_PROVIDER=sandbox unless this is true (staging sites only).
ALLOW_SANDBOX_IN_PRODUCTION=false

# Password given to the seeded demo accounts (npm run db:seed).
SEED_PASSWORD=Mlaz@2026demo
